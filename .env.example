# Disposable, loopback-only development credentials. Set unique values on shared hosts.
POSTGRES_PASSWORD=sourcera-local-db
RABBITMQ_PASSWORD=sourcera-local-broker
MINIO_ACCESS_KEY=sourcera-local
MINIO_SECRET_KEY=sourcera-local-object-store
MINIO_BUCKET=sourcera-audio
# Empty generates a shared signing key in the private state volume.
JWT_SECRET=
DEMO_MODE=false
FRONTEND_PORT=5173
API_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_CONSOLE_PORT=9001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_HOURS=12
RATE_PER_MINUTE=60
MAX_REQUEST_BYTES=12582912
DATASET_DIR=/datasets
DATASET_FILES=
# Enable any of bloomberg,dw,bbc,forex-factory
NEWS_SOURCES=
RSS_FEED_URLS=
CRAWL_URLS=
RSS_INTERVAL_MINUTES=60
NEWS_HTML_PARSER=beautifulsoup
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLUSTER_SIMILARITY=0.46
# Set to [ml] or [ml,crawl] before rebuilding to install optional dependencies.
BACKEND_EXTRAS=
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional dedicated writer; other reasoning and voice models remain independent.
BRIEFING_LLM_MODEL=
BRIEFING_LLM_TIMEOUT_SECONDS=20
NEWS_LLM_MODEL=
# Named public feeds are opt-in, e.g. bbc-world,bbc-technology,dw,guardian-world,aljazeera.
RSS_MAX_ARTICLES=20
RSS_MAX_AGE_HOURS=48
NEWS_ENRICH_FEEDS=0
# Separate live web lookup after the listener accepts a research offer.
WEB_RESEARCH_ENABLED=1
WEB_RESEARCH_MODEL=gpt-4.1-mini
TTS_PROVIDER=local
# Fit copied scripts to each narrator's measured pace. Disable to reuse older cached editions.
VOICE_DETAIL_FIT=1
# Legacy endpoint mode. Listeners select OpenAI / ElevenLabs in their own preferences.
CONVERSATION_PROVIDER=local
ELEVENLABS_AGENT_ID=
ELEVENLABS_ALLOW_LICENSED_CONTEXT=0
ELEVENLABS_API_KEY=
# Additional speech keys, comma-separated; the primary key remains first in the pool.
ELEVENLABS_API_KEYS=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_MAP={}
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
STT_PROVIDER=mock
STT_BASE_URL=
STT_MODEL=whisper-1
STT_API_KEY=
STT_USD_PER_MINUTE=0
LLM_TIMEOUT_SECONDS=180
# Set for a dated archive. The UI displays the archive date explicitly.
NEWS_REFERENCE_TIME=
NEWS_EDITION_VERSION=
DAILY_NEWS_PERIOD=day
ACTIVE_CORPUS=
FACT_EXTRACTION_PROVIDER=rules
CONTRADICTION_PROVIDER=rules
CLUSTER_LLM_VERIFY=0
CLUSTER_REVIEW_SIMILARITY=0.78
ANALYSIS_BATCH_SIZE=10
RANK_WEIGHTS={}
LLM_INPUT_USD_PER_M=0
LLM_OUTPUT_USD_PER_M=0
TTS_USD_PER_M_CHARS=0

TTS_LOCAL_FALLBACK=1
COMPUTE_USD_PER_HOUR=0.04

# Streamed speech-to-speech. Key stays on the server and defaults to LLM_API_KEY.
REALTIME_ENABLED=0
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

# Realtime hears the user; generated text streams directly to the selected ElevenLabs voice.
REALTIME_SPEECH_PROVIDER=elevenlabs
ELEVENLABS_CONVERSATION_MODEL=eleven_flash_v2_5

# Browser Web Push uses a private VAPID key persisted in STATE_DIR.
WEB_PUSH_ENABLED=1
WEB_PUSH_SUBJECT=https://your-public-sourcera-host.example
# Optional CPU model. This handles writing/text questions, independently of audio providers.
LOCAL_LLM_ENABLED=0
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen3:0.6b
LOCAL_LLM_TIMEOUT_SECONDS=35

# Google Identity Services: Web OAuth client ID. Add the site origin in Google Cloud.
GOOGLE_CLIENT_ID=
